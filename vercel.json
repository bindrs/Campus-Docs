{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/campusdocs build && pnpm --filter @workspace/api-server build:vercel",
  "outputDirectory": "artifacts/campusdocs/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}